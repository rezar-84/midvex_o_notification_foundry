<odoo>

    <!-- "Send on Telegram" for the models this module's dependencies bring in.

         Only the two that genuinely need sale and account live here. The
         contact and lead bindings sit in the foundry and the Telegram adapter
         respectively, because res.partner needs nothing beyond base and
         crm.lead needs only crm - keeping them here meant an install of
         foundry + telegram had the composer and no way to send from a record
         at all, gated behind Invoicing by accident.

         Bindings are per-model in Odoo; there is no way to bind one action to
         every model with a chatter. Adding another model later is a copy of one
         record with a different binding_model_id and model_id, placed in
         whichever module already depends on it.

         Not noupdate: pure UI wiring with nothing for an admin to customise, so
         it should follow the module on upgrade. -->

    <record id="action_send_telegram_sale" model="ir.actions.server">
        <field name="name">Send on Telegram</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = env['midvex.notification.compose'].action_open_for_record('sale.order', record.id)</field>
    </record>

    <record id="action_send_telegram_invoice" model="ir.actions.server">
        <field name="name">Send on Telegram</field>
        <field name="model_id" ref="account.model_account_move"/>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">form</field>
        <field name="state">code</field>
        <field name="code">action = env['midvex.notification.compose'].action_open_for_record('account.move', record.id)</field>
    </record>

</odoo>
