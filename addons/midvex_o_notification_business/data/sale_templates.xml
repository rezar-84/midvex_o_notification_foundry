<odoo noupdate="1">

    <record id="template_sale_confirmed" model="midvex.notification.template">
        <field name="name">Sales order confirmed</field>
        <field name="code">sale_order_confirmed</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="subject">Order confirmed: {{ object.name }}</field>
        <field name="body">{{ object.name }} was confirmed for {{ object.partner_id.name }}.
Total: {{ object.amount_total }} {{ object.currency_id.name }}
Salesperson: {{ object.user_id.name or 'unassigned' }}</field>
    </record>

    <record id="rule_sale_confirmed" model="midvex.notification.rule">
        <field name="name">Sales order confirmed -&gt; Telegram</field>
        <field name="model_id" ref="sale.model_sale_order"/>
        <field name="trigger">on_write</field>
        <field name="trigger_domain">[('state', '=', 'sale')]</field>
        <field name="template_id" ref="template_sale_confirmed"/>
        <field name="channel_ids" eval="[(4, ref('midvex_o_notification_telegram.channel_telegram'))]"/>
    </record>

</odoo>
