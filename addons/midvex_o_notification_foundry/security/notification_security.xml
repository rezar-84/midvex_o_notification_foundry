<odoo>
    <record id="module_category_notification" model="ir.module.category"><field name="name">Notifications</field><field name="sequence">30</field></record>
    <record id="privilege_notification" model="res.groups.privilege"><field name="name">Notifications</field><field name="category_id" ref="module_category_notification"/><field name="sequence">30</field></record>
    <record id="group_notification_user" model="res.groups"><field name="name">User</field><field name="privilege_id" ref="privilege_notification"/><field name="sequence">10</field></record>
    <record id="group_notification_manager" model="res.groups"><field name="name">Manager</field><field name="privilege_id" ref="privilege_notification"/><field name="sequence">20</field><field name="implied_ids" eval="[(4, ref('group_notification_user'))]"/></record>
    <record id="group_notification_admin" model="res.groups"><field name="name">Administrator</field><field name="privilege_id" ref="privilege_notification"/><field name="sequence">30</field><field name="implied_ids" eval="[(4, ref('group_notification_manager'))]"/></record>

    <!-- Without this the module installs invisible to everyone, including the
         admin: the root menu requires group_notification_user and nothing
         granted it, so an `application` module appeared to install and then
         showed no menu at all. Administrator implies Manager implies User, so
         one grant opens the whole tree, and it is specifically the admin group
         that ungates the Bot Token field on the account form. -->
    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_notification_admin'))]"/>
    </record>

    <record id="rule_notification_account_company" model="ir.rule"><field name="name">Notification accounts by company</field><field name="model_id" ref="model_midvex_notification_account"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_notification_user'))]"/></record>
    <record id="rule_notification_rule_company" model="ir.rule"><field name="name">Notification rules by company</field><field name="model_id" ref="model_midvex_notification_rule"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_notification_user'))]"/></record>
    <record id="rule_notification_message_manager" model="ir.rule"><field name="name">Notification messages by company (managers)</field><field name="model_id" ref="model_midvex_notification_message"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_notification_manager'))]"/></record>
    <record id="rule_notification_message_self" model="ir.rule"><field name="name">Notification messages: self only for users</field><field name="model_id" ref="model_midvex_notification_message"/><field name="domain_force">[('recipient_id.user_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('group_notification_user'))]"/></record>
    <record id="rule_notification_log_manager" model="ir.rule"><field name="name">Notification logs by company (managers)</field><field name="model_id" ref="model_midvex_notification_log"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_notification_manager'))]"/></record>
    <record id="rule_notification_log_self" model="ir.rule"><field name="name">Notification logs: self only for users</field><field name="model_id" ref="model_midvex_notification_log"/><field name="domain_force">[('message_id.recipient_id.user_id', '=', user.id)]</field><field name="groups" eval="[(4, ref('group_notification_user'))]"/></record>
    <record id="rule_notification_inbound_event_company" model="ir.rule"><field name="name">Notification inbound events by company</field><field name="model_id" ref="model_midvex_notification_inbound_event"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_notification_manager'))]"/></record>

    <record id="rule_notification_recipient_self" model="ir.rule"><field name="name">Notification recipients: self or manager by company</field><field name="model_id" ref="model_midvex_notification_recipient"/><field name="domain_force">['&amp;', ('company_id', 'in', company_ids), '|', ('user_id', '=', user.id), ('user_id', '=', False)]</field><field name="groups" eval="[(4, ref('group_notification_user'))]"/></record>
    <record id="rule_notification_recipient_manager" model="ir.rule"><field name="name">Notification recipients: company scope for managers</field><field name="model_id" ref="model_midvex_notification_recipient"/><field name="domain_force">[('company_id', 'in', company_ids)]</field><field name="groups" eval="[(4, ref('group_notification_manager'))]"/></record>
</odoo>
