<odoo>
    <record id="action_notification_accounts" model="ir.actions.act_window">
        <field name="name">Accounts</field>
        <field name="res_model">midvex.notification.account</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Connect a channel account</p>
            <p>
                An account holds the credentials for one channel — for Telegram, the
                bot token from @BotFather. Create it, press <b>Test Connection</b>, and
                it must reach <b>Connected</b> before recipients can be linked to it.
            </p>
        </field>
    </record>

    <record id="action_notification_recipients" model="ir.actions.act_window">
        <field name="name">Recipients</field>
        <field name="res_model">midvex.notification.recipient</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No recipients yet</p>
            <p>
                A recipient links an Odoo user to their account on a channel. Until a
                recipient reaches <b>Linked</b> they are skipped silently when a rule
                fires — no alert is delivered and no error is raised.
            </p>
        </field>
    </record>

    <record id="action_notification_templates" model="ir.actions.act_window">
        <field name="name">Templates</field>
        <field name="res_model">midvex.notification.template</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Write a message template</p>
            <p>
                Templates render with inline templating against the record that
                triggered the rule, for example <code>{{ object.name }}</code>.
            </p>
        </field>
    </record>

    <record id="action_notification_rules" model="ir.actions.act_window">
        <field name="name">Rules</field>
        <field name="res_model">midvex.notification.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Decide what gets notified</p>
            <p>
                A rule ties a model and a trigger to a template, one or more channels,
                and an audience. A rule with no audience delivers to nobody, so set one.
            </p>
        </field>
    </record>

    <!-- Opens on what needs a human. The full queue is one click away by clearing
         the filter, but landing on thousands of delivered rows buries the failures. -->
    <record id="action_notification_messages" model="ir.actions.act_window">
        <field name="name">Message Queue</field>
        <field name="res_model">midvex.notification.message</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_filter_needs_attention': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Nothing needs attention</p>
            <p>
                Failed and quarantined messages appear here. Clear the filter to see
                everything that has been queued, including delivered messages.
            </p>
        </field>
    </record>

    <record id="action_notification_logs" model="ir.actions.act_window">
        <field name="name">Delivery Logs</field>
        <field name="res_model">midvex.notification.log</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No delivery attempts logged yet</p>
            <p>
                One row per delivery attempt, including retries. This is the audit
                trail behind each message in the queue.
            </p>
        </field>
    </record>

    <record id="action_notification_channels" model="ir.actions.act_window">
        <field name="name">Channels</field>
        <field name="res_model">midvex.notification.channel</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No channels installed</p>
            <p>
                A channel is registered by its adapter module — installing
                <b>Midvex Telegram Notifications</b> creates the Telegram one. You
                rarely need to add these by hand.
            </p>
        </field>
    </record>

    <record id="action_notification_inbound_events" model="ir.actions.act_window">
        <field name="name">Inbound Events</field>
        <field name="res_model">midvex.notification.inbound.event</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No inbound events received</p>
            <p>
                Replies sent to the bot arrive here, including the link codes recipients
                send to connect their account. An empty list while someone is waiting to
                be linked usually means the webhook is not registered.
            </p>
        </field>
    </record>

    <menuitem id="menu_notification_root" name="Notifications" sequence="90" groups="midvex_o_notification_foundry.group_notification_user"/>
    <!-- Manager-gated: sending by hand reaches real people's chats, which is not
         something a read-only Notification User should be able to do. -->
    <menuitem id="menu_notification_compose" name="Send Message" parent="menu_notification_root"
              action="action_notification_compose" sequence="5"
              groups="midvex_o_notification_foundry.group_notification_manager"/>
    <menuitem id="menu_notification_messages" name="Message Queue" parent="menu_notification_root" action="action_notification_messages" sequence="10"/>
    <menuitem id="menu_notification_logs" name="Delivery Logs" parent="menu_notification_root" action="action_notification_logs" sequence="20"/>
    <menuitem id="menu_notification_recipients" name="Recipients" parent="menu_notification_root" action="action_notification_recipients" sequence="30"/>
    <menuitem id="menu_notification_config" name="Configuration" parent="menu_notification_root" sequence="90" groups="midvex_o_notification_foundry.group_notification_manager"/>
    <menuitem id="menu_notification_accounts" name="Accounts" parent="menu_notification_config" action="action_notification_accounts" sequence="10"/>
    <menuitem id="menu_notification_rules" name="Rules" parent="menu_notification_config" action="action_notification_rules" sequence="20"/>
    <menuitem id="menu_notification_templates" name="Templates" parent="menu_notification_config" action="action_notification_templates" sequence="30"/>
    <menuitem id="menu_notification_inbound_events" name="Inbound Events" parent="menu_notification_config" action="action_notification_inbound_events" sequence="40"/>
    <menuitem id="menu_notification_channels" name="Channels" parent="menu_notification_config" action="action_notification_channels" sequence="50"/>
</odoo>
