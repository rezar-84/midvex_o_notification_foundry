<odoo>

  <!-- ============ Thread ============ -->

  <record id="view_conversation_thread_list" model="ir.ui.view">
    <field name="name">midvex.conversation.thread.list</field>
    <field name="model">midvex.conversation.thread</field>
    <field name="arch" type="xml">
      <!-- Unanswered is bold rather than red: a customer waiting is the normal
           state of a working inbox, not an alarm. -->
      <list create="false" decoration-bf="unanswered" decoration-muted="status == 'resolved'">
        <field name="last_message_at" string="Last Activity"/>
        <field name="name"/>
        <field name="identity_id"/>
        <field name="partner_id" optional="show"/>
        <field name="last_channel_code" string="Channel"/>
        <field name="assigned_user_id" widget="many2one_avatar_user"/>
        <field name="company_id" groups="base.group_multi_company"/>
        <field name="message_count" string="Messages" optional="hide"/>
        <field name="unanswered" optional="hide"/>
        <field name="priority" widget="priority"/>
        <field name="status" widget="badge"
               decoration-warning="status == 'waiting_agent'"
               decoration-info="status in ('new', 'open')"
               decoration-success="status == 'resolved'"/>
      </list>
    </field>
  </record>

  <record id="view_conversation_thread_form" model="ir.ui.view">
    <field name="name">midvex.conversation.thread.form</field>
    <field name="model">midvex.conversation.thread</field>
    <field name="arch" type="xml">
      <form create="false">
        <header>
          <button name="action_resolve" type="object" string="Resolve" class="btn-primary"
                  invisible="status in ('resolved', 'archived')"/>
          <button name="action_reopen" type="object" string="Reopen"
                  invisible="status not in ('resolved', 'archived')"/>
          <field name="status" widget="statusbar"
                 statusbar_visible="new,open,waiting_agent,waiting_customer,resolved"/>
        </header>
        <sheet>
          <div class="oe_title">
            <h1><field name="name" placeholder="Conversation"/></h1>
          </div>
          <div class="alert alert-warning" role="alert" invisible="not unanswered">
            The customer spoke last. Nobody has replied yet.
          </div>
          <group>
            <group>
              <field name="identity_id"/>
              <field name="partner_id"/>
              <field name="assigned_user_id" widget="many2one_avatar_user"/>
              <field name="priority" widget="priority"/>
            </group>
            <group>
              <field name="company_id" groups="base.group_multi_company"/>
              <field name="first_channel_code" string="First Channel"/>
              <field name="last_channel_code" string="Last Channel"/>
              <field name="language_code"/>
              <field name="first_response_at"/>
              <field name="last_message_at"/>
              <field name="resolved_at" invisible="not resolved_at"/>
            </group>
          </group>
          <notebook>
            <page string="Messages">
              <field name="message_ids" nolabel="1" readonly="1">
                <list decoration-muted="direction == 'internal'"
                      decoration-danger="state == 'failed'">
                  <field name="create_date" string="At"/>
                  <field name="direction"/>
                  <field name="body"/>
                  <field name="author_user_id" optional="show"/>
                  <field name="origin" optional="hide"/>
                  <field name="state" widget="badge"
                         decoration-success="state in ('delivered', 'read')"
                         decoration-danger="state == 'failed'"/>
                  <field name="error_message_safe" optional="hide"/>
                </list>
              </field>
              <p class="text-muted">
                Replying from here is phase 4. The service API can already send —
                <code>queue_outbound()</code> — but there is no compose box yet, so a
                reply has to come from a channel module or the shell.
              </p>
            </page>
            <page string="Channels">
              <field name="session_ids" nolabel="1" readonly="1">
                <list>
                  <field name="channel_code"/>
                  <field name="account_id"/>
                  <field name="external_recipient_id" string="Reply To"/>
                  <field name="opened_at"/>
                  <field name="last_activity_at"/>
                  <field name="state" widget="badge" decoration-success="state == 'open'"/>
                </list>
              </field>
            </page>
            <page string="Assignment History">
              <field name="assignment_event_ids" nolabel="1" readonly="1">
                <list>
                  <field name="create_date" string="At"/>
                  <field name="from_user_id"/>
                  <field name="to_user_id"/>
                  <field name="actor_user_id"/>
                  <field name="reason"/>
                </list>
              </field>
            </page>
          </notebook>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_conversation_thread_search" model="ir.ui.view">
    <field name="name">midvex.conversation.thread.search</field>
    <field name="model">midvex.conversation.thread</field>
    <field name="arch" type="xml">
      <search>
        <field name="name"/>
        <field name="identity_id"/>
        <field name="partner_id"/>
        <field name="assigned_user_id"/>
        <filter name="unanswered" string="Waiting on Us" domain="[('unanswered', '=', True)]"/>
        <filter name="mine" string="Assigned to Me"
                domain="[('assigned_user_id', '=', uid)]"/>
        <filter name="unassigned" string="Unassigned"
                domain="[('assigned_user_id', '=', False)]"/>
        <separator/>
        <filter name="live" string="Open"
                domain="[('status', 'in', ['new', 'open', 'waiting_agent', 'waiting_customer'])]"/>
        <filter name="resolved" string="Resolved" domain="[('status', '=', 'resolved')]"/>
        <separator/>
        <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
        <filter name="group_assigned" string="Assigned To"
                context="{'group_by': 'assigned_user_id'}"/>
        <filter name="group_channel" string="Channel"
                context="{'group_by': 'last_channel_code'}"/>
      </search>
    </field>
  </record>

  <record id="action_conversation_thread" model="ir.actions.act_window">
    <field name="name">Conversations</field>
    <field name="res_model">midvex.conversation.thread</field>
    <field name="view_mode">list,form</field>
    <field name="context">{'search_default_live': 1}</field>
    <field name="help" type="html">
      <p class="o_view_nocontent_smiling_face">No conversations yet</p>
      <p>
        Conversations arrive from a channel — a customer messaging a connected
        WhatsApp number, or the website chat widget. They are not created by hand.
      </p>
    </field>
  </record>

  <!-- ============ Identity ============ -->

  <record id="view_conversation_identity_list" model="ir.ui.view">
    <field name="name">midvex.conversation.identity.list</field>
    <field name="model">midvex.conversation.identity</field>
    <field name="arch" type="xml">
      <list>
        <field name="identity_type"/>
        <field name="display_identifier"/>
        <field name="normalized_identifier" optional="hide"/>
        <field name="partner_id"/>
        <field name="company_id" groups="base.group_multi_company"/>
        <field name="verified" widget="boolean_toggle"/>
        <field name="last_seen_at"/>
      </list>
    </field>
  </record>

  <record id="view_conversation_identity_form" model="ir.ui.view">
    <field name="name">midvex.conversation.identity.form</field>
    <field name="model">midvex.conversation.identity</field>
    <field name="arch" type="xml">
      <form>
        <sheet>
          <group>
            <group>
              <field name="identity_type"/>
              <field name="display_identifier"/>
              <field name="normalized_identifier"/>
              <field name="provider_identifier" optional="hide"/>
            </group>
            <group>
              <field name="partner_id"/>
              <field name="company_id" groups="base.group_multi_company"/>
              <field name="verified"/>
              <field name="verification_source"/>
              <field name="first_seen_at"/>
              <field name="last_seen_at"/>
            </group>
          </group>
          <p class="text-muted">
            Matching happens on the normalized identifier alone. A display name or a
            username is the person's to change, so matching on one would reassign a
            conversation the day they renamed themselves.
          </p>
          <field name="thread_ids" readonly="1">
            <list>
              <field name="name"/>
              <field name="status"/>
              <field name="last_message_at"/>
            </list>
          </field>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_conversation_identity" model="ir.actions.act_window">
    <field name="name">Identities</field>
    <field name="res_model">midvex.conversation.identity</field>
    <field name="view_mode">list,form</field>
  </record>

</odoo>
