<odoo>
  <data noupdate="0">

    <!--
      Company scoping on every conversation model.

      Attached to group_notification_user, which manager and admin imply, so
      one rule covers the whole ladder rather than three that can drift apart.
      This deliberately extends the existing three groups instead of adding a
      parallel set: an agent is already a notification user, and a second
      hierarchy would mean two places to get somebody's access wrong.

      Every one of these is company_ids rather than company_id — a user allowed
      into two companies should see both companies' conversations, not only the
      one they happen to have selected.
    -->

    <record id="rule_conversation_identity_company" model="ir.rule">
      <field name="name">Conversation identities by company</field>
      <field name="model_id" ref="model_midvex_conversation_identity"/>
      <field name="domain_force">[('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[(4, ref('midvex_o_notification_foundry.group_notification_user'))]"/>
    </record>

    <record id="rule_conversation_thread_company" model="ir.rule">
      <field name="name">Conversations by company</field>
      <field name="model_id" ref="model_midvex_conversation_thread"/>
      <field name="domain_force">[('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[(4, ref('midvex_o_notification_foundry.group_notification_user'))]"/>
    </record>

    <record id="rule_conversation_session_company" model="ir.rule">
      <field name="name">Conversation sessions by company</field>
      <field name="model_id" ref="model_midvex_conversation_session"/>
      <field name="domain_force">[('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[(4, ref('midvex_o_notification_foundry.group_notification_user'))]"/>
    </record>

    <!--
      Messages are scoped by company and not by assignment.

      Scoping them to the assigned agent was considered and rejected: a
      conversation nobody has claimed would then be invisible to everybody,
      which is exactly the conversation most in need of being seen. Supervision,
      handover and picking up an unassigned enquiry all require reading a thread
      that is not yours.
    -->
    <record id="rule_conversation_message_company" model="ir.rule">
      <field name="name">Conversation messages by company</field>
      <field name="model_id" ref="model_midvex_conversation_message"/>
      <field name="domain_force">[('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[(4, ref('midvex_o_notification_foundry.group_notification_user'))]"/>
    </record>

    <record id="rule_conversation_assignment_event_company" model="ir.rule">
      <field name="name">Conversation assignment history by company</field>
      <field name="model_id" ref="model_midvex_conversation_assignment_event"/>
      <field name="domain_force">[('company_id', 'in', company_ids)]</field>
      <field name="groups" eval="[(4, ref('midvex_o_notification_foundry.group_notification_user'))]"/>
    </record>

  </data>
</odoo>
