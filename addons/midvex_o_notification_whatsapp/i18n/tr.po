#. module: midvex_o_notification_whatsapp
#: model_terms:ir.ui.view,arch_db:midvex_o_notification_whatsapp.view_notification_account_form_whatsapp
msgid ""
"<strong>Credentials go on the Credentials page.</strong>\n"
"              The access token is the <em>Bot Token / API Key</em> field, the app secret\n"
"              is <em>API Secret</em>, and the webhook verify token is\n"
"              <em>Webhook Secret</em>."
msgstr ""
"<strong>Kimlik bilgileri Kimlik Bilgileri sayfasındadır.</strong>\n"
"              Erişim belirteci <em>Bot Token / API Key</em> alanı, uygulama gizli anahtarı\n"
"              <em>API Secret</em>, webhook doğrulama belirteci ise\n"
"              <em>Webhook Secret</em> alanıdır."

#. module: midvex_o_notification_whatsapp
#. odoo-python
#: code:addons/midvex_o_notification_whatsapp/models/whatsapp_account.py:0
msgid ""
"A WhatsApp account needs its Phone Number ID. Without it no message can be "
"sent and no webhook can be matched to this account."
msgstr "Bir WhatsApp hesabı için Telefon Numarası ID zorunludur. Bu olmadan hiçbir mesaj gönderilemez ve hiçbir webhook bu hesapla eşleştirilemez."

#. module: midvex_o_notification_whatsapp
#. odoo-python
#: code:addons/midvex_o_notification_whatsapp/models/whatsapp_template_map.py:0
msgid "A template mapping needs a language code."
msgstr "Şablon eşleştirmesi için dil kodu zorunludur."

