#. module: midvex_o_notification_whatsapp
#: model_terms:ir.ui.view,arch_db:midvex_o_notification_whatsapp.view_whatsapp_template_form
msgid ""
"Approved templates address their variables positionally — <code>{{1}}</code>,\n"
"            <code>{{2}}</code> — so the order above is the order Meta will substitute\n"
"            them in. A name that is not in the message produces an empty variable\n"
"            rather than a failed send."
msgstr ""
"Onaylı şablonlar değişkenlerine konuma göre başvurur — <code>{{1}}</code>,\n"
"            <code>{{2}}</code> — dolayısıyla yukarıdaki sıra, Meta’nın değerleri yerleştireceği\n"
"            sıradır. Mesajda bulunmayan bir ad, başarısız bir gönderim yerine boş bir\n"
"            değişken üretir."

#. module: midvex_o_notification_whatsapp
#: model:ir.model.fields.selection,name:midvex_o_notification_whatsapp.selection__midvex_notification_whatsapp_template__provider_category__authentication
msgid "Authentication"
msgstr "Kimlik Doğrulama"

